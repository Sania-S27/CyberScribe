# ==============================================================================
# CyberScribe - Unified Environment Configuration Template
# ==============================================================================
# Copy this file to:
#   - backend/.env    (for FastAPI backend configuration)
#   - frontend/.env   (for React/Vite frontend configuration)
# Fill in your specific environment values before starting the application.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------

# Application Core
APP_NAME="CyberScribe"
DEBUG=True

# Relational Database Connection (MySQL 8.0+)
# Replace <DB_USER> and <DB_PASSWORD> with your MySQL credentials
MYSQL_DATABASE_URL="mysql+pymysql://<DB_USER>:<DB_PASSWORD>@localhost:3306/threat_agent_db"

# ChromaDB Vector Storage Directory
CHROMADB_PATH="./chroma_storage"

# Google Gemini API Key (Required for LLM Agents: Analyst, Validator, Mitigation)
GOOGLE_API_KEY="YOUR_GEMINI_API_KEY"
model_name="gemini-2.5-flash-lite"

# JWT Secret Key for Session Authentication (Generate: openssl rand -hex 32)
JWT_SECRET_KEY="YOUR_JWT_SECRET_KEY_HERE"

# Continuous OSINT Ingestion Polling Interval (in seconds; default: 14400 = 4 hours)
OSINT_POLL_INTERVAL_SECONDS=14400

# Containment Lifecycle & Firewall Adapter Mode
# Options: "simulated" (default, safe simulation) | "windows_firewall" | "fedora_nftables"
CONTAINMENT_ADAPTER_MODE="simulated"

# Fedora 44 VirtualBox nftables Executor (:8088 Microservice)
# Required only if CONTAINMENT_ADAPTER_MODE="fedora_nftables"
FEDORA_EXECUTOR_URL="http://127.0.0.1:8088"
FEDORA_EXECUTOR_TOKEN="YOUR_FEDORA_EXECUTOR_TOKEN_HERE"
FEDORA_NFTABLES_TABLE="cyberscribe"

# Windows Defender Firewall Executor Daemon (Port :8089)
WINDOWS_EXECUTOR_URL="http://127.0.0.1:8089"
WINDOWS_EXECUTOR_PORT=8089
WINDOWS_EXECUTOR_TOKEN="YOUR_WINDOWS_EXECUTOR_TOKEN_HERE"

# Lab Safeguard: Allow host containment against authorized lab test IP
ALLOW_LAB_FEDORA_HOST_CONTAINMENT="false"

# Email Notification & Brevo Transactional Email Configuration
# Default: false (simulation mode, audit ledger only, zero outbound network traffic)
EMAIL_PROVIDER="brevo"
EMAIL_ENABLED=false
BREVO_API_KEY="YOUR_BREVO_API_KEY_HERE"
BREVO_API_URL="https://api.brevo.com/v3/smtp/email"

# Fallback SMTP Relay Configuration (optional legacy mode)
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="alerts@yourdomain.com"
SMTP_FROM_NAME="CyberScribe Security"
SMTP_USE_TLS=true

# Frontend Origin URL (for CORS and email redirect links)
FRONTEND_URL="http://localhost:5173"

# Default Seed Super Admin Credentials (for seed_admin.py)
SEED_ADMIN_EMAIL="admin@cyberscribe.local"
SEED_ADMIN_PASSWORD="YOUR_ADMIN_PASSWORD_HERE"

# ------------------------------------------------------------------------------
# Frontend Configuration (frontend/.env)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL="http://127.0.0.1:8001"

