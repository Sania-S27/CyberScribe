APP_NAME="CyberScribe"
DEBUG=True
MYSQL_DATABASE_URL="mysql+pymysql://<DB_USER>:<DB_PASSWORD>@localhost:3306/threat_agent_db"
CHROMADB_PATH="./chroma_storage"
GOOGLE_API_KEY="YOUR_GEMINI_API_KEY"
model_name="gemini-2.5-flash-lite"
JWT_SECRET_KEY="YOUR_JWT_SECRET_KEY_HERE"

# Continuous OSINT Ingestion Polling Interval (in seconds; default: 14400 = 4 hours)
OSINT_POLL_INTERVAL_SECONDS=14400

# Containment Lifecycle & Firewall Adapter Mode
# Options: "simulated" (default, safe simulation) or "fedora_nftables" (live VM execution)
CONTAINMENT_ADAPTER_MODE="simulated"

# Fedora 44 VirtualBox nftables Executor Configuration (Required if CONTAINMENT_ADAPTER_MODE="fedora_nftables")
# Host port forwarded to Fedora 44 guest NAT:
FEDORA_EXECUTOR_URL="http://127.0.0.1:8088"
# High-entropy shared secret (configured on Fedora VM in /etc/cyberscribe-executor.env):
FEDORA_EXECUTOR_TOKEN="YOUR_FEDORA_EXECUTOR_TOKEN_HERE"
# Dedicated nftables table name (separate from firewalld):
FEDORA_NFTABLES_TABLE="cyberscribe"

# Windows Defender Firewall Executor Daemon Configuration (Optional loopback microservice)
# Binds strictly to 127.0.0.1:8089:
WINDOWS_EXECUTOR_URL="http://127.0.0.1:8089"
WINDOWS_EXECUTOR_PORT=8089
WINDOWS_EXECUTOR_TOKEN="YOUR_WINDOWS_EXECUTOR_TOKEN_HERE"

# Lab Safeguard: Set to "true" only when executing live demo against the authorized Fedora lab IP
ALLOW_LAB_FEDORA_HOST_CONTAINMENT="false"

# Email Notification & Brevo Transactional Email Configuration
# Set EMAIL_ENABLED=true to enable live outbound delivery.
# Default is false: email operates in safe simulation mode (audit ledger only, zero network traffic).
EMAIL_PROVIDER=brevo
EMAIL_ENABLED=false
# Brevo v3 Transactional Email REST API Key (preferred, avoids SMTP IP-whitelisting restrictions):
BREVO_API_KEY="YOUR_BREVO_API_KEY_HERE"
BREVO_API_URL="https://api.brevo.com/v3/smtp/email"
# Fallback SMTP Relay Configuration (optional legacy mode):
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="alerts@yourdomain.com"
SMTP_FROM_NAME="CyberScribe Security"
SMTP_USE_TLS=true
FRONTEND_URL="http://localhost:5173"

# Seed Admin Account Defaults (for seed_admin.py)
SEED_ADMIN_EMAIL="admin@cyberscribe.local"
SEED_ADMIN_PASSWORD="YOUR_ADMIN_PASSWORD_HERE"
